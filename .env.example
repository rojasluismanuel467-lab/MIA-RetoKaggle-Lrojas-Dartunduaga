# Copia este archivo como .env y ajusta los valores según la corrida.
RUN_HEAVY_EXPERIMENTS=false
RUN_OPTIMIZATION=false

# auto = CUDA si existe, luego MPS en Apple Silicon, y finalmente CPU.
# Valores válidos: auto, cuda, mps, cpu.
DEVICE=auto

# true = reutiliza checkpoints con el mismo nombre; false = reentrena.
REUSE_CHECKPOINTS=true

# MLflow local: registra parámetros, métricas, historial y checkpoints.
MLFLOW_ENABLED=true
MLFLOW_LOG_MODELS=true
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=aaiv-cnn-drowsiness
